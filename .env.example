# Copy this file to ".env" and fill in your own values.
# Never share your .env file or commit it to git.

# From @BotFather, looks like 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN=

# Optional: your chat id, a number like 123456789 (groups start with -).
# Leave empty and just send your bot a message: it will find your chat itself.
TELEGRAM_CHAT_ID=
