# Copy this file to ".env" and fill it in. Never share or commit .env.

# ===== Multi-user bot (python -m signalbot) =====
# Token of the bot from @BotFather. Use a NEW bot for the public product.
BOT_TOKEN=

# Your own Telegram user id(s), comma separated (get it from @userinfobot).
# Admins can use /stats /broadcast /grant /refund /backup and get daily backups.
ADMIN_IDS=

# Who users contact about payments (shown in /paysupport), e.g. @yourname
SUPPORT_CONTACT=

# Optional: free CoinGecko "Demo" API key for higher limits (coingecko.com/en/api)
COINGECKO_API_KEY=

# Plans (defaults shown)
# PRO_PRICE_STARS=250
# FREE_MAX_ALERTS=3
# PRO_MAX_ALERTS=50
# TRIAL_DAYS=3
# REFERRAL_BONUS_DAYS=30
# DIGEST_HOUR_UTC=8
# DB_PATH=data/signalbot.db

# ===== Personal single-user bot (python bot.py) =====
TELEGRAM_BOT_TOKEN=
# Optional: leave empty and just message your bot, it finds your chat itself.
TELEGRAM_CHAT_ID=
